{
  "name": "critbox",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "CritBox MVP (Bioma Labs): D20 3D em web app e mobile nativo",
  "scripts": {
    "test": "node --test src/core/*.test.ts src/render/*.test.ts",
    "test:coverage": "node --experimental-test-coverage --test src/core/*.test.ts src/render/*.test.ts",
    "typecheck": "tsc --noEmit",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "cap:sync": "cap sync",
    "cap:build": "npm run build && cap sync"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.3",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@types/node": "^22.0.0",
    "@types/three": "^0.170.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
